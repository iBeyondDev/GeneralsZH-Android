# Meson cross file: DXVK native for Android arm64-v8a (generated by cmake/dx8.cmake
# or scripts/build/android/probe-dxvk.sh). @VAR@ placeholders are filled in by configure_file.
[binaries]
c       = '@ANDROID_LLVM_BIN@/aarch64-linux-android@ANDROID_API@-clang'
cpp     = '@ANDROID_LLVM_BIN@/aarch64-linux-android@ANDROID_API@-clang++'
ar      = '@ANDROID_LLVM_BIN@/llvm-ar'
strip   = '@ANDROID_LLVM_BIN@/llvm-strip'
pkg-config = 'pkg-config'

[properties]
needs_exe_wrapper = true

[built-in options]
c_args        = ['-fPIC']
cpp_args      = ['-fPIC']
c_link_args   = ['-Wl,-z,max-page-size=16384']
cpp_link_args = ['-Wl,-z,max-page-size=16384']

[host_machine]
system     = 'android'
cpu_family = 'aarch64'
cpu        = 'armv8-a'
endian     = 'little'
